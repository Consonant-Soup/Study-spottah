// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum Standing {
  freshman
  sophmore
  junior
  senior
  masters
  phd
}

model Profile {
  id          Int      @id @default(autoincrement())
  profilepic    String?
  uhemail       String @unique
  username      String?  @unique
  firstName     String
  lastName      String
  major         String
  standing      Standing @default(freshman)
}

enum YesNoUnknown {
  yes
  no
  unknown
}

enum NoiseLevel {
  LEVEL_1 @map("1")
  LEVEL_2 @map("2")
  LEVEL_3 @map("3")
  LEVEL_4 @map("4")
  LEVEL_5 @map("5")
  LEVEL_6 @map("6")
  LEVEL_7 @map("7")
}

enum Major {
  Engineering
  Bio
  Math
}

model Spot {
  id          Int          @id @default(autoincrement())
  location    String
  outdoors    YesNoUnknown @default(unknown)
  ac          YesNoUnknown @default(unknown)
  microwave   YesNoUnknown @default(unknown)
  outlets     YesNoUnknown @default(unknown)
  windows     YesNoUnknown @default(unknown)
  groupstudy  YesNoUnknown @default(unknown)
  tutors      YesNoUnknown @default(unknown)
  printer     YesNoUnknown @default(unknown)
  noiselvl    NoiseLevel
  foodAllowed YesNoUnknown @default(unknown)
  majors      Major[]
  seating     YesNoUnknown @default(unknown)
  computers   YesNoUnknown @default(unknown)
}
