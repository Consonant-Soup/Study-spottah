// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum Standing {
  freshman
  sophmore
  junior
  senior
  masters
  phd
}

model Profile {
  id          Int      @id @default(autoincrement())
  profilepic    String?
  uhemail       String @unique
  username      String?  @unique
  firstName     String
  lastName      String
  major         String
  standing      Standing @default(freshman)
  convenedMeetings Meeting[] @relation("MeetingConvener")
  meetingParticipations MeetingParticipant[]
}

enum YesNoUnknown {
  yes
  no
  unknown
}

enum NoiseLevel {
  LEVEL_1 @map("1")
  LEVEL_2 @map("2")
  LEVEL_3 @map("3")
  LEVEL_4 @map("4")
  LEVEL_5 @map("5")
  LEVEL_6 @map("6")
  LEVEL_7 @map("7")
}

enum Major {
  Engineering
  Bio
  Math
}

model Spot {
  id          Int          @id @default(autoincrement())
  location    String
  outdoors    YesNoUnknown @default(unknown)
  ac          YesNoUnknown @default(unknown)
  microwave   YesNoUnknown @default(unknown)
  outlets     YesNoUnknown @default(unknown)
  windows     YesNoUnknown @default(unknown)
  groupstudy  YesNoUnknown @default(unknown)
  tutors      YesNoUnknown @default(unknown)
  printer     YesNoUnknown @default(unknown)
  noiselvl    NoiseLevel
  foodAllowed YesNoUnknown @default(unknown)
  majors      Major[]
  seating     YesNoUnknown @default(unknown)
  computers   YesNoUnknown @default(unknown)
  meetings    Meeting[]
}

enum MeetingStatus {
  scheduled
  cancelled
}

enum MeetingResponse {
  pending
  accepted
  declined
}

model Meeting {
  id                 Int                 @id @default(autoincrement())
  spotId             Int
  convenerProfileId  Int
  startAt            DateTime            @db.Timestamptz(3)
  endAt              DateTime            @db.Timestamptz(3)
  timeZone           String
  status             MeetingStatus       @default(scheduled)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  spot               Spot                @relation(fields: [spotId], references: [id], onDelete: Restrict)
  convener           Profile             @relation("MeetingConvener", fields: [convenerProfileId], references: [id], onDelete: Restrict)
  participants       MeetingParticipant[]

  @@index([startAt, status])
  @@index([convenerProfileId])
}

model MeetingParticipant {
  meetingId         Int
  profileId         Int
  response          MeetingResponse @default(pending)
  reminderSentAt    DateTime?       @db.Timestamptz(3)
  reminderClaimedAt DateTime?       @db.Timestamptz(3)
  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([meetingId, profileId])
  @@index([profileId, response])
}
