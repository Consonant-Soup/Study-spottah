// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

enum Standing {
  freshman
  sophmore
  junior
  senior
  masters
  phd
}

model Profile {
  id          Int      @id @default(autoincrement())
  profilepic    String?
  uhemail       String @unique
  username      String?  @unique
  firstName     String
  lastName      String
  major         String
  standing      Standing @default(freshman)
  convenedMeetings Meeting[] @relation("MeetingConvener")
  meetingParticipations MeetingParticipant[]
}

enum YesNoUnknown {
  yes
  no
  unknown
}

enum NoiseLevel {
  LEVEL_1 @map("1")
  LEVEL_2 @map("2")
  LEVEL_3 @map("3")
  LEVEL_4 @map("4")
  LEVEL_5 @map("5")
}

enum Coverage {
  INDOOR
  OUTDOOR
  OUTDOOR_COVERED
}

enum SpotStatus {
  PENDING
  APPROVED
  REJECTED
}

model Spot {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  status    SpotStatus @default(PENDING)
  name      String
  location  String?
  coverage  Coverage

  // Required amenities
  outlets     YesNoUnknown @default(unknown)
  foodAllowed YesNoUnknown @default(unknown)
  microwave   YesNoUnknown @default(unknown)
  groupstudy  YesNoUnknown @default(unknown)

  // Optional amenities
  ac                 YesNoUnknown @default(unknown)
  printer            YesNoUnknown @default(unknown)
  computers          YesNoUnknown @default(unknown)
  whiteboard         YesNoUnknown @default(unknown)
  projector          YesNoUnknown @default(unknown)
  chalkboard         YesNoUnknown @default(unknown)
  windows            YesNoUnknown @default(unknown)
  tutors             YesNoUnknown @default(unknown)
  freePaper          YesNoUnknown @default(unknown)
  largeFormatPrinter YesNoUnknown @default(unknown)

  // Adjacency
  nearBathroom       YesNoUnknown @default(unknown)
  nearWaterFountain  YesNoUnknown @default(unknown)
  nearVendingMachine YesNoUnknown @default(unknown)
  nearFoodStore      YesNoUnknown @default(unknown)
  nearBusStop        YesNoUnknown @default(unknown)
  nearShuttle        YesNoUnknown @default(unknown)

  noiselvl NoiseLevel
  imageUrl String?
  comments String?

  meetings Meeting[]
}

enum MeetingStatus {
  scheduled
  cancelled
}

enum MeetingResponse {
  pending
  accepted
  declined
}

model Meeting {
  id                 Int                 @id @default(autoincrement())
  spotId             Int
  convenerProfileId  Int
  startAt            DateTime            @db.Timestamptz(3)
  endAt              DateTime            @db.Timestamptz(3)
  timeZone           String
  status             MeetingStatus       @default(scheduled)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  spot               Spot                @relation(fields: [spotId], references: [id], onDelete: Restrict)
  convener           Profile             @relation("MeetingConvener", fields: [convenerProfileId], references: [id], onDelete: Restrict)
  participants       MeetingParticipant[]

  @@index([startAt, status])
  @@index([convenerProfileId])
}

model MeetingParticipant {
  meetingId         Int
  profileId         Int
  response          MeetingResponse @default(pending)
  reminderSentAt    DateTime?       @db.Timestamptz(3)
  reminderClaimedAt DateTime?       @db.Timestamptz(3)
  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@id([meetingId, profileId])
  @@index([profileId, response])
}
